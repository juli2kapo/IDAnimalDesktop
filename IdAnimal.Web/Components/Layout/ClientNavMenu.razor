<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="/cliente">IdAnimal</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="cliente" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Inicio
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="clientes">
                <span class="bi bi-building-nav-menu" aria-hidden="true"></span> Clientes
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="animales">
                <span class="bi bi-list-nav-menu" aria-hidden="true"></span> Animales
            </NavLink>
        </div>
        <AuthorizeView>
            <Authorized>
                @if (context.User.FindFirst("is_client_admin")?.Value?.ToLower() == "true")
                {
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="organizacion">
                            <span class="bi bi-people-nav-menu" aria-hidden="true"></span> Organización
                        </NavLink>
                    </div>
                }
            </Authorized>
        </AuthorizeView>
    </nav>
</div>
