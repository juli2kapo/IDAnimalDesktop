@code {
    [Parameter]
    public int Id { get; set; }

    private CattleDto? cattle;
    private string? establishmentRenspa;
    private bool isLoading = true;
    private bool loadFailed = false;
    private string imageType = "snout";
    private bool isSaving = false;
    private bool showEditModal = false;
    private bool showDeleteConfirmModal = false;

    private bool showUploadModal = false;
    private bool isUploading = false;


    // QR de la ficha pública. Se calcula una vez por animal (no en el render):
    // codificar el QR y pasarlo a base64 no es gratis y no cambia entre renders.
    private string? qrDataUri;
    private string? publicUrl;

    private List<string> displayImages = new();
    private List<string> displayVideos = new();
    private bool showImageModal = false;
    private string? currentImageUrl;
    private string? uploadError;
    private string? uploadStatus; // Feedback during loop
    private List<IBrowserFile> selectedFiles = new();
    private const long MaxFileSize = 1024 * 1024 * 5; // 5 MB limit
    private const int MaxAllowedFiles = 10;

    private string? errorMessage;
    private string? successMessage;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Cargamos en OnAfterRenderAsync porque ProtectedLocalStorage (token JWT) sólo está
        // disponible una vez que la conexión SignalR/JS está activa. Si lo hiciéramos en
        // OnInitializedAsync, el token sería null en pre-render y la API devolvería 401/404.
        if (!firstRender) return;
        Console.WriteLine($"[CattleDetail] OnAfterRenderAsync first render for cattle ID: {Id}");
        await LoadCattle();
        StateHasChanged();
    }

    private async Task LoadCattle()
    {
        isLoading = true;
        Console.WriteLine($"[CattleDetail] LoadCattle started for ID: {Id}");

        try
        {
            Console.WriteLine($"[CattleDetail] Calling CattleService.GetByIdAsync({Id})");
            var detailDto = await CattleService.GetByIdAsync(Id);
            Console.WriteLine("detailDto");
            var str = Newtonsoft.Json.JsonConvert.SerializeObject(detailDto);
            Console.WriteLine(str);
            if (detailDto != null)
            {
                Console.WriteLine($"[CattleDetail] Successfully received data for cattle: {detailDto.Caravan}");
                cattle = new CattleDto
                {
                    Id = detailDto.Id,
                    GlobalId = detailDto.GlobalId,
                    Caravan = detailDto.Caravan,
                    Name = detailDto.Name,
                    Weight = detailDto.Weight,
                    Origin = detailDto.Origin,
                    Age = detailDto.Age,
                    Gender = detailDto.Gender,
                    GDM = detailDto.GDM,
                    EstablishmentId = detailDto.EstablishmentId,
                    EstablishmentName = detailDto.EstablishmentName,
                    ImageCount = detailDto.Images?.Count ?? 0,
                    VideoCount = detailDto.Videos?.Count ?? 0,
                    CustomData = detailDto.CustomData,
                    BirthDate = detailDto.BirthDate,
                    SanitaryHistory = detailDto.SanitaryHistory,
                    FeedPasturePct = detailDto.FeedPasturePct,
                    FeedFeedlotPct = detailDto.FeedFeedlotPct,
                    FeedOrganicPct = detailDto.FeedOrganicPct,
                    WeightProgressPct = detailDto.WeightProgressPct,
                    Certifications = detailDto.Certifications,
                };

                // QR de la ficha pública. Si fallara la codificación no queremos
                // tumbar toda la ficha: la tarjeta simplemente no se muestra.
                if (!string.IsNullOrWhiteSpace(cattle.GlobalId))
                {
                    try
                    {
                        publicUrl = QrService.PublicUrl(cattle.GlobalId);
                        qrDataUri = QrService.ToDataUri(publicUrl);
                    }
                    catch (Exception ex)
                    {
                        Console.WriteLine($"[CattleDetail] No se pudo generar el QR: {ex.Message}");
                        publicUrl = null;
                        qrDataUri = null;
                    }
                }

                displayImages = new List<string>();

                if (detailDto.Images != null)
                    displayImages.AddRange(
                        detailDto.Images.Select(i => i.Path).Where(p => !string.IsNullOrWhiteSpace(p)));

                if (detailDto.FullImages != null)
                    displayImages.AddRange(
                        detailDto.FullImages.Select(i => i.Path).Where(p => !string.IsNullOrWhiteSpace(p)));

                if (detailDto.Videos != null)
                    displayVideos = detailDto.Videos.Select(v => v.Path)
                        .Where(p => !string.IsNullOrWhiteSpace(p)).ToList();

                // RENSPA del establecimiento dueño (si está disponible)
                try
                {
                    if (cattle.EstablishmentId > 0)
                    {
                        var estab = await EstablishmentService.GetByIdAsync(cattle.EstablishmentId);
                        establishmentRenspa = estab?.Renspa;
                    }
                }
                catch
                {
                    // Sin RENSPA, la card muestra "—"
                }

                Console.WriteLine($"[CattleDetail] Cattle DTO created successfully");
            }
            else
            {
                Console.WriteLine($"[CattleDetail] API returned null for cattle ID: {Id}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[CattleDetail] Exception in LoadCattle: {ex.GetType().Name} - {ex.Message}");
            Console.WriteLine($"[CattleDetail] Stack trace: {ex.StackTrace}");
            errorMessage = "Error al cargar los datos. Mostrando datos de ejemplo.";
            cattle = GetMockCattle(Id);
            Console.WriteLine($"[CattleDetail] Loaded mock data for cattle ID: {Id}");
        }
        finally
        {
            isLoading = false;
            loadFailed = cattle == null;
            Console.WriteLine($"[CattleDetail] LoadCattle completed. isLoading = false");
        }
    }

    private CattleDto GetMockCattle(int id)
    {
        var random = new Random(id);
        var establishments = new[] { "Estancia La Pampa", "Campo El Ombú", "Hacienda Los Teros" };
        var genders = new[] { "Macho", "Hembra" };
        var origins = new[] { "Angus", "Hereford", "Brahman", "Charolais" };

        return new CattleDto
        {
            Id = id,
            Caravan = $"A{id:D4}",
            EstablishmentName = establishments[random.Next(establishments.Length)],
            Weight = random.Next(250, 650),
            Origin = origins[random.Next(origins.Length)],
            Gender = genders[random.Next(genders.Length)],
            GDM = Math.Round((decimal)(random.NextDouble() * 1.5 + 0.5), 2),
            Age = random.Next(1, 8),
            ImageCount = random.Next(0, 5),
            VideoCount = random.Next(0, 2),
            CustomData = new Dictionary<string, string>
            {
                { "Raza", origins[random.Next(origins.Length)] },
                { "Color", random.Next(2) == 0 ? "Negro" : "Colorado" },
                { "Vacunado", random.Next(2) == 0 ? "Sí" : "No" }
            }
        };
    }

    private void GoBack()
    {
        Console.WriteLine("[CattleDetail] GoBack button clicked");
        Navigation.NavigateTo("/animales");
    }

    private void CloseErrorMessage()
    {
        Console.WriteLine($"[CattleDetail] Error message closed: {errorMessage}");
        errorMessage = null;
    }

    private void CloseSuccessMessage()
    {
        Console.WriteLine($"[CattleDetail] Success message closed: {successMessage}");
        successMessage = null;
    }

    private void ShowEditModal()
    {
        showEditModal = true;
    }

    private void HideEditModal()
    {
        showEditModal = false;
    }

    private void ShowDeleteConfirm()
    {
        showDeleteConfirmModal = true;
    }

    private void OpenImageModal(string url)
    {
        currentImageUrl = url;
        showImageModal = true;
    }

    private void CloseImageModal()
    {
        showImageModal = false;
        currentImageUrl = null;
    }

    private bool HasCert(string key)
        => cattle != null && CertCatalog.Contains(cattle.Certifications, key);

    private void ToggleCert(string key, bool include)
    {
        if (cattle == null) return;
        cattle.Certifications = CertCatalog.Toggle(cattle.Certifications, key, include);
    }

    private async Task UpdateCattle()
    {
        if (cattle == null) return;

        isSaving = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            var success = await CattleService.UpdateAsync(cattle.Id, cattle);
            if (success)
            {
                successMessage = "Animal actualizado correctamente";
                HideEditModal();
                await LoadCattle();
            }
            else
            {
                errorMessage = "Error al actualizar el animal";
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Error al conectar con el servidor";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task DeleteCattle()
    {
        if (cattle == null) return;

        isSaving = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            var success = await CattleService.DeleteAsync(cattle.Id);
            if (success)
            {
                Navigation.NavigateTo("/animales");
            }
            else
            {
                errorMessage = "Error al eliminar el animal";
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Error al conectar con el servidor";
        }
        finally
        {
            isSaving = false;
        }
    }

    private void ShowUploadModal()
    {
        selectedFiles.Clear();
        uploadError = null;
        uploadStatus = null;
        showUploadModal = true;
    }

    private void HideUploadModal()
    {
        showUploadModal = false;
    }

    // Capture multiple files from the InputFile component
    private void HandleFileSelection(InputFileChangeEventArgs e)
    {
        uploadError = null;
        uploadStatus = null;

        try
        {
            var files = e.GetMultipleFiles(MaxAllowedFiles);
            foreach (var file in files)
            {
                // Simple duplicate check by name/size
                if (!selectedFiles.Any(f => f.Name == file.Name && f.Size == file.Size))
                {
                    if (file.Size > MaxFileSize)
                    {
                        uploadError = $"El archivo {file.Name} excede el límite de 5MB y no fue agregado.";
                    }
                    else
                    {
                        selectedFiles.Add(file);
                    }
                }
            }
        }
        catch (Exception ex)
        {
            uploadError = "Demasiados archivos seleccionados o error al leer.";
            Console.WriteLine(ex.Message);
        }
    }

    private void RemoveFile(IBrowserFile file)
    {
        selectedFiles.Remove(file);
    }

    // Loop process and Upload
    private async Task UploadSelectedImages()
    {
        if (!selectedFiles.Any() || cattle == null) return;

        isUploading = true;
        uploadError = null;
        uploadStatus = null;
        int successCount = 0;
        int total = selectedFiles.Count;

        try
        {
            for (int i = 0; i < total; i++)
            {
                var file = selectedFiles[i];
                uploadStatus = $"Subiendo {i + 1} de {total}: {file.Name}...";
                StateHasChanged(); // Force UI to update text

                var success = await CattleService.UploadImageAsync(cattle.GlobalId, file, imageType);

                if (success)
                {
                    successCount++;
                }
            }

            if (successCount == total)
            {
                successMessage = $"{successCount} imágenes subidas correctamente.";
                HideUploadModal();
                await LoadCattle(); // Refresh to see the new images
            }
            else
            {
                uploadError = $"Se completaron {successCount} de {total} subidas. Algunas fallaron.";
                if (successCount > 0) await LoadCattle();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error uploading images: {ex.Message}");
            uploadError = "Ocurrió un error inesperado al procesar las imágenes.";
        }
        finally
        {
            isUploading = false;
            uploadStatus = null;
        }
    }
}
