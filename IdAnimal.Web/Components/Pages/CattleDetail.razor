        padding: 9px 16px;
        border-radius: var(--border-radius-sm);
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-weight: 700;
        letter-spacing: 0.4px;
    }

        .ca-weight-bar i {
            margin-right: 8px;
        }

        .ca-weight-bar strong {
            font-size: 18px;
            font-weight: 900;
        }

    /* Caravana + QR (col-1, row-2) */
    .ca-caravan {
        grid-column: 1;
        grid-row: 2;
        text-align: center;
    }

    .ca-caravan-title {
        margin-bottom: 2px !important;
    }

    .ca-caravan-num {
        font-family: 'Roboto Condensed', monospace;
        font-size: 13px;
        color: var(--text-secondary);
        font-weight: 600;
        letter-spacing: 0.4px;
    }

    .ca-qr {
        margin-top: 8px;
        display: flex;
        justify-content: center;
        background: white;
        padding: 12px;
        border-radius: var(--border-radius-sm);
        border: 1.5px solid var(--border-color);
    }

        .ca-qr img {
            display: block;
            width: 100%;
            max-width: 200px;
            height: auto;
        }

    /* Atributos (col-2/3, row-2) */
    .ca-attrs {
        grid-column: 2 / span 2;
        grid-row: 2;
    }

    .ca-attrs-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 14px 22px;
    }

    .ca-attr-label {
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.6px;
        color: var(--text-secondary);
        margin-bottom: 2px;
    }

    .ca-attr-value {
        font-size: 14px;
        font-weight: 700;
        color: var(--text-primary);
    }

    .ca-cert-row {
        margin-top: 18px;
        padding-top: 14px;
        border-top: 1.5px dashed var(--border-color);
        display: flex;
        align-items: center;
        gap: 14px;
        flex-wrap: wrap;
    }

    /* Datos personalizados / media: filas adicionales */
    .ca-custom,
    .ca-media {
        grid-column: 1 / -1;
    }

    .ca-thumb-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
        gap: 10px;
    }

    .ca-thumb {
        aspect-ratio: 1;
        border-radius: var(--border-radius-sm);
        overflow: hidden;
        border: 1.5px solid var(--border-color);
        cursor: pointer;
    }

        .ca-thumb img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .ca-thumb-video {
        width: 100%;
        border-radius: var(--border-radius-sm);
        border: 1.5px solid var(--border-color);
    }

    @@media (max-width: 1100px) {
        .cattle-card-layout {
            grid-template-columns: 1fr 1fr;
        }
        .ca-photo     { grid-column: 1 / -1; grid-row: auto; min-height: 240px; }
        .ca-sanitary  { grid-column: 1; grid-row: auto; }
        .ca-feed      { grid-column: 2; grid-row: auto; }
        .ca-caravan   { grid-column: 1; grid-row: auto; }
        .ca-attrs     { grid-column: 2; grid-row: auto; }
    }

    @@media (max-width: 720px) {
        .cattle-card-layout { grid-template-columns: 1fr; }
        .ca-photo, .ca-sanitary, .ca-feed,
        .ca-caravan, .ca-attrs, .ca-custom, .ca-media {
            grid-column: 1 !important;
            grid-row: auto !important;
        }
        .ca-attrs-grid { grid-template-columns: repeat(2, 1fr); }
    }

    /* ── Skeleton loaders ────────────────────────────────────── */
    @@keyframes skeleton-shimmer {
        0%   { background-position: -200% 0; }
        100% { background-position: 200% 0; }
    }

    .skeleton-block,
    .skeleton-line,
    .skeleton-icon,
    .skeleton-bar,
    .skeleton-pill,
    .skeleton-qr {
        background: linear-gradient(
            90deg,
            var(--surface-bg) 0%,
            var(--hover-bg) 50%,
            var(--surface-bg) 100%
        );
        background-size: 200% 100%;
        animation: skeleton-shimmer 1.4s ease-in-out infinite;
        border-radius: var(--border-radius-sm);
        display: block;
    }

    .skeleton-block { width: 100%; height: 100%; min-height: 280px; }

    .skeleton-icon {
        width: 36px;
        height: 36px;
        border-radius: 8px;
        flex-shrink: 0;
    }

    .skeleton-line {
        height: 12px;
        margin: 6px 0;
    }

    .skeleton-line-sm   { width: 40%; }
    .skeleton-line-md   { width: 60%; }
    .skeleton-line-lg   { width: 80%; }
    .skeleton-line-full { width: 100%; }

    .skeleton-bar {
        height: 6px;
        width: 100%;
        margin: 6px 0 14px;
        border-radius: 3px;
    }

    .skeleton-pill {
        height: 44px;
        width: 100%;
        margin-top: 12px;
        border-radius: var(--border-radius-sm);
    }

    .skeleton-qr {
        width: 100%;
        max-width: 200px;
        aspect-ratio: 1;
        margin: 8px auto 0;
        border-radius: var(--border-radius-sm);
    }

    /* --- QR de la ficha pública --- */
    .ca-qr-body {
        display: flex;
        gap: 18px;
        align-items: flex-start;
        padding: 16px;
        flex-wrap: wrap;
    }

    .ca-qr-img {
        width: 148px;
