@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using IdAnimal.Shared.DTOs
@using IdAnimal.Web.Services
@inject CattleService CattleService
@inject QrService QrService
@inject EstablishmentService EstablishmentService
@inject NavigationManager Navigation

<PageTitle>Detalle del Animal - IdAnimal</PageTitle>

<div class="page-container">
    <div class="page-header">
        <button class="btn btn-secondary" @onclick="GoBack">
            <i class="bi bi-arrow-left"></i> Volver
        </button>
        <div class="header-actions">
            <button class="btn btn-primary" @onclick="ShowEditModal">
                <i class="bi bi-pencil"></i> Editar
            </button>
            <button class="btn btn-danger" @onclick="ShowDeleteConfirm">
                <i class="bi bi-trash"></i> Eliminar
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @errorMessage
            <button type="button" class="btn-close" @onclick="CloseErrorMessage"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show">
            @successMessage
            <button type="button" class="btn-close" @onclick="CloseSuccessMessage"></button>
        </div>
    }

    @if (isLoading || cattle == null && !loadFailed)
    {
        <div class="cattle-card-layout">
            <div class="ca-photo skeleton-block"></div>
            <div class="ca-card ca-sanitary">
                <div class="ca-card-header">
                    <span class="skeleton-icon"></span>
                    <span class="skeleton-line skeleton-line-md"></span>
                </div>
                <span class="skeleton-line skeleton-line-full"></span>
                <span class="skeleton-line skeleton-line-full"></span>
                <span class="skeleton-line skeleton-line-full"></span>
                <span class="skeleton-line skeleton-line-lg"></span>
            </div>
            <div class="ca-card ca-feed">
                <div class="ca-card-header">
                    <span class="skeleton-icon"></span>
                    <span class="skeleton-line skeleton-line-md"></span>
                </div>
                <span class="skeleton-line skeleton-line-full"></span>
                <span class="skeleton-line skeleton-bar"></span>
                <span class="skeleton-line skeleton-line-full"></span>
                <span class="skeleton-line skeleton-bar"></span>
                <span class="skeleton-line skeleton-line-full"></span>
                <span class="skeleton-line skeleton-bar"></span>
                <span class="skeleton-line skeleton-pill"></span>
            </div>
            <div class="ca-card ca-caravan">
                <div class="ca-card-header">
                    <span class="skeleton-icon"></span>
                    <span class="skeleton-line skeleton-line-sm"></span>
                </div>
                <div class="skeleton-qr"></div>
            </div>
            <div class="ca-card ca-attrs">
                <div class="ca-card-header">
                    <span class="skeleton-icon"></span>
                    <span class="skeleton-line skeleton-line-md"></span>
                </div>
                <div class="ca-attrs-grid">
                    @for (var i = 0; i < 6; i++)
                    {
                        <div>
                            <span class="skeleton-line skeleton-line-sm"></span>
                            <span class="skeleton-line skeleton-line-md"></span>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
    else if (cattle == null)
    {
        <div class="alert alert-danger">
            No se encontró el animal solicitado.
        </div>
    }
    else
    {
        <div class="cattle-card-layout">
            <!-- Foto del animal -->
            <div class="ca-photo">
                @{
                    var firstImage = ApiUrl.Resolve(
                        displayImages.FirstOrDefault(p => !string.IsNullOrWhiteSpace(p)));
                }
                @if (firstImage is not null)
                {
                    <img src="@firstImage" alt="@cattle.Caravan"
                         @onclick="() => OpenImageModal(firstImage)" />
                }
                else
                {
                    <div class="ca-photo-placeholder" @onclick="ShowUploadModal">
                        <i class="bi bi-image"></i>
                        <span>Subir foto</span>
                    </div>
                }
            </div>

            <!-- Historia sanitaria -->
            <div class="ca-card ca-sanitary">
                <div class="ca-card-header">
                    <span class="ca-icon ca-icon-red"><i class="bi bi-heart-pulse-fill"></i></span>
                    <h3>Historia sanitaria</h3>
                </div>
                <div class="ca-sanitary-text">
                    @if (!string.IsNullOrWhiteSpace(cattle.SanitaryHistory))
                    {
                        @cattle.SanitaryHistory
                    }
                    else
                    {
                        <span class="ca-empty">Sin historia sanitaria registrada.</span>
                    }
                </div>
            </div>

            <!-- Alimentación y peso -->
            <div class="ca-card ca-feed">
                <div class="ca-card-header">
                    <span class="ca-icon ca-icon-orange"><i class="bi bi-bar-chart-fill"></i></span>
                    <h3>Alimentación y Peso</h3>
                </div>
                <div class="ca-bars">
                    <FeedBar Label="Alimentación en el campo" Pct="@cattle.FeedPasturePct" Color="#A8C58F" />
                    <FeedBar Label="Alimentación Feedlot"     Pct="@cattle.FeedFeedlotPct" Color="#B89968" />
                    <FeedBar Label="Alimentación Orgánica"    Pct="@cattle.FeedOrganicPct" Color="#88AED4" />
                    <FeedBar Label="Peso"                      Pct="@cattle.WeightProgressPct" Color="#D49A9A" />
                </div>
                <div class="ca-weight-bar">
                    <span><i class="bi bi-clipboard-data"></i> Peso</span>
                    <strong>@(cattle.Weight?.ToString("0") ?? "—") Kg</strong>
                </div>
            </div>

            <!-- Caravana + QR -->
            <div class="ca-card ca-caravan">
                <div class="ca-card-header">
                    <span class="ca-icon ca-icon-orange"><i class="bi bi-tag-fill"></i></span>
                    <div>
                        <h3 class="ca-caravan-title">Caravana</h3>
                        <div class="ca-caravan-num">@cattle.Caravan</div>
                    </div>
                </div>
                <div class="ca-qr">
                    <img src="https://api.qrserver.com/v1/create-qr-code/?size=180x180&margin=0&data=@(Uri.EscapeDataString(cattle.Caravan))"
                         alt="QR @cattle.Caravan" />
                </div>
            </div>

            <!-- Atributos -->
            <div class="ca-card ca-attrs">
                <div class="ca-card-header">
                    <span class="ca-icon ca-icon-red"><i class="bi bi-heart-fill"></i></span>
                    <h3>Id.animal + atributos</h3>
                </div>
                <div class="ca-attrs-grid">
                    <div class="ca-attr">
                        <div class="ca-attr-label">Nacimiento</div>
                        <div class="ca-attr-value">@(cattle.BirthDate?.ToString("dd/MM/yyyy") ?? "—")</div>
                    </div>
                    <div class="ca-attr">
                        <div class="ca-attr-label">Género</div>
                        <div class="ca-attr-value">@(cattle.Gender ?? "—")</div>
                    </div>
                    <div class="ca-attr">
                        <div class="ca-attr-label">RENSPA</div>
                        <div class="ca-attr-value">@(establishmentRenspa ?? "—")</div>
                    </div>
                    <div class="ca-attr">
                        <div class="ca-attr-label">Establecimiento</div>
                        <div class="ca-attr-value">@(cattle.EstablishmentName ?? "—")</div>
                    </div>
                    <div class="ca-attr">
                        <div class="ca-attr-label">Origen</div>
                        <div class="ca-attr-value">@(cattle.Origin ?? "—")</div>
                    </div>
                    <div class="ca-attr">
                        <div class="ca-attr-label">GDM</div>
                        <div class="ca-attr-value">@(cattle.GDM?.ToString("0.00") ?? "—")</div>
                    </div>
                </div>

                @{
                    var certs = CertCatalog.Parse(cattle.Certifications).ToList();
                }
                @if (certs.Any())
                {
                    <div class="ca-cert-row">
                        @foreach (var cert in certs)
                        {
                            <CertSeal Cert="cert" />
                        }
                    </div>
                }
            </div>

            @if (cattle.CustomData != null && cattle.CustomData.Any())
            {
                <div class="ca-card ca-custom">
                    <div class="ca-card-header">
                        <span class="ca-icon ca-icon-green"><i class="bi bi-list-check"></i></span>
                        <h3>Datos personalizados</h3>
                    </div>
                    <div class="ca-attrs-grid">
                        @foreach (var f in cattle.CustomData)
                        {
                            <div class="ca-attr">
                                <div class="ca-attr-label">@f.Key</div>
                                <div class="ca-attr-value">@f.Value</div>
                            </div>
                        }
                    </div>
                </div>
            }

            @if (qrDataUri != null && publicUrl != null)
            {
                <div class="ca-card ca-qr">
                    <div class="ca-card-header">
                        <span class="ca-icon ca-icon-green"><i class="bi bi-qr-code"></i></span>
                        <h3>Ficha pública</h3>
                    </div>
                    <div class="ca-qr-body">
                        <img class="ca-qr-img" src="@qrDataUri" alt="Código QR de la ficha pública" />
                        <div class="ca-qr-side">
                            <p class="ca-qr-hint">
                                Escaneá el código para abrir la ficha pública del animal.
                                No requiere iniciar sesión.
                            </p>
                            <a class="ca-qr-link" href="@publicUrl" target="_blank" rel="noopener">@publicUrl</a>
                            <div class="ca-qr-actions">
                                <a class="btn btn-sm btn-primary"
                                   href="@qrDataUri" download="@($"{cattle.Caravan}_qr.svg")">
                                    <i class="bi bi-download"></i> Descargar QR
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }

            @if (displayImages.Count > 1 || displayVideos.Any())
            {
                <div class="ca-card ca-media">
                    <div class="ca-card-header">
                        <span class="ca-icon ca-icon-orange"><i class="bi bi-images"></i></span>
                        <h3>Imágenes y videos</h3>
                        <button class="btn btn-sm btn-outline-primary ms-auto" @onclick="ShowUploadModal">
                            <i class="bi bi-plus-lg"></i> Subir
                        </button>
                    </div>
                    <div class="ca-thumb-grid">
                        @foreach (var imgUrl in displayImages.Skip(1))
                        {
                            var resolved = ApiUrl.Resolve(imgUrl);
                            <div class="ca-thumb" @onclick="() => OpenImageModal(resolved!)">
                                <img src="@resolved" alt="Imagen" />
                            </div>
                        }
                        @foreach (var vidUrl in displayVideos)
                        {
                            <video class="ca-thumb-video" controls>
                                <source src="@ApiUrl.Resolve(vidUrl)" type="video/mp4">
                            </video>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

@if (showEditModal)
{
    <div class="modal fade show" style="display: block;" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Editar Animal</h5>
                    <button type="button" class="btn-close" @onclick="HideEditModal"></button>
                </div>
                <EditForm Model="@cattle" OnValidSubmit="@UpdateCattle">
                    <div class="modal-body">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Caravana *</label>
                                <InputText class="form-control" @bind-Value="cattle.Caravan" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Peso (kg)</label>
                                <InputNumber class="form-control" step="0.01" lang="en" @bind-Value="cattle.Weight" />
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Origen</label>
                                <InputText class="form-control" @bind-Value="cattle.Origin" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Género</label>
                                <select class="form-select" @bind="cattle.Gender">
                                    <option value="">Seleccione...</option>
                                    <option value="Macho">Macho</option>
                                    <option value="Hembra">Hembra</option>
                                </select>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">GDM</label>
                                <InputNumber class="form-control" step="0.01" lang="en" @bind-Value="cattle.GDM" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Edad</label>
                                <InputNumber class="form-control" step="1" lang="en" @bind-Value="cattle.Age" />
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Nacimiento</label>
                                <InputDate class="form-control" @bind-Value="cattle.BirthDate" />
                            </div>
                        </div>

                        <hr class="form-divider" />
                        <h6 class="form-section-title">Historia sanitaria</h6>
                        <div class="row">
                            <div class="col-12 mb-3">
                                <InputTextArea class="form-control" rows="4"
                                               placeholder="Ej: EST. LIBRE DE BRUCELOSIS, fechas de vacunación, antecedentes..."
                                               @bind-Value="cattle.SanitaryHistory" />
                            </div>
                        </div>

                        <h6 class="form-section-title">Alimentación y peso (%)</h6>
                        <div class="row">
                            <div class="col-md-3 mb-3">
                                <label class="form-label">Campo</label>
                                <InputNumber class="form-control" min="0" max="100" step="1" lang="en"
                                             @bind-Value="cattle.FeedPasturePct" />
                            </div>
                            <div class="col-md-3 mb-3">
                                <label class="form-label">Feedlot</label>
                                <InputNumber class="form-control" min="0" max="100" step="1" lang="en"
                                             @bind-Value="cattle.FeedFeedlotPct" />
                            </div>
                            <div class="col-md-3 mb-3">
                                <label class="form-label">Orgánica</label>
                                <InputNumber class="form-control" min="0" max="100" step="1" lang="en"
                                             @bind-Value="cattle.FeedOrganicPct" />
                            </div>
                            <div class="col-md-3 mb-3">
                                <label class="form-label">Peso (progreso)</label>
                                <InputNumber class="form-control" min="0" max="100" step="1" lang="en"
                                             @bind-Value="cattle.WeightProgressPct" />
                            </div>
                        </div>

                        <h6 class="form-section-title">Certificaciones</h6>
                        <div class="row">
                            <div class="col-12 mb-3">
                                <div class="cert-checkboxes">
                                    @foreach (var cert in CertCatalog.All)
                                    {
                                        <label class="cert-checkbox">
                                            <input type="checkbox"
                                                   checked="@HasCert(cert.Key)"
                                                   @onchange="e => ToggleCert(cert.Key, (bool)e.Value!)" />
                                            <span class="cert-checkbox-label">@cert.Label</span>
                                        </label>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="HideEditModal">Cancelar</button>
                        <button type="submit" class="btn btn-primary" disabled="@isSaving">
                            @if (isSaving)
                            {
                                <span class="spinner-border spinner-border-sm"></span>
                            }
                            Guardar Cambios
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@if (showDeleteConfirmModal)
{
    <div class="modal fade show" style="display: block;" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirmar Eliminación</h5>
                    <button type="button" class="btn-close" @onclick="() => showDeleteConfirmModal = false"></button>
                </div>
                <div class="modal-body">
                    <p>¿Está seguro que desea eliminar el animal con caravana "<strong>@cattle?.Caravan</strong>"?</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="() => showDeleteConfirmModal = false">Cancelar</button>
                    <button type="button" class="btn btn-danger" @onclick="DeleteCattle" disabled="@isSaving">
                        @if (isSaving)
                        {
                            <span class="spinner-border spinner-border-sm"></span>
                        }
                        Eliminar
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}
@if (showUploadModal)
{
    <div class="modal fade show" style="display: block;" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Subir Imágenes</h5>
                    <button type="button" class="btn-close" @onclick="HideUploadModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Tipo de Imagen (para la selección)</label>
                        <select class="form-select" @bind="imageType">
                            <option value="Snout">Hocico (Para Análisis)</option>
                            <option value="Full">Cuerpo Completo</option>
                            <option value="Caravan">Caravana</option>
                        </select>
                        <div class="form-text text-muted">
                            Seleccione "Hocico" para generar identificación biométrica.
                        </div>
                    </div>

                    <div class="mb-3">
                        <div class="upload-drop-zone">
                            <InputFile OnChange="@HandleFileSelection" multiple class="form-control" accept=".jpg,.jpeg,.png" />
                            <i class="bi bi-cloud-arrow-up upload-icon"></i>
                            <div>
                                <strong>Haga clic o arrastre imágenes aquí</strong>
                            </div>
                        </div>
                    </div>

                    @if (selectedFiles.Any())
                    {
                        <div class="mb-3">
                            <label class="detail-label">Archivos Seleccionados (@selectedFiles.Count)</label>
                            <div class="selected-files-list">
                                @foreach (var file in selectedFiles)
                                {
                                    <div class="file-list-item">
                                        <div class="text-truncate">
                                            <i class="bi bi-file-earmark-image text-primary"></i> 
                                            @file.Name <small class="text-muted">(@(file.Size / 1024) KB)</small>
                                        </div>
                                        <button class="btn btn-sm btn-link text-danger" @onclick="() => RemoveFile(file)">
                                            <i class="bi bi-x"></i>
                                        </button>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(uploadError))
                    {
                        <div class="alert alert-danger">@uploadError</div>
                    }

                    @if (!string.IsNullOrEmpty(uploadStatus))
                    {
                        <div class="alert alert-info">
                            @if (isUploading) { <span class="spinner-border spinner-border-sm me-2"></span> }
                            @uploadStatus
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="HideUploadModal">Cancelar</button>
                    <button type="button" class="btn btn-primary" @onclick="UploadSelectedImages" disabled="@(!selectedFiles.Any() || isUploading)">
                        @if (isUploading)
                        {
                            <span class="spinner-border spinner-border-sm"></span>
                        }
                        Subir Imágenes
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}
@if (showImageModal)
{
    <div class="modal fade show" style="display: block; background-color: rgba(0,0,0,0.8);" tabindex="-1" @onclick="CloseImageModal">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content bg-transparent border-0">
                <div class="modal-body text-center position-relative">
                    <button type="button" class="btn-close btn-close-white position-absolute top-0 end-0 m-3" @onclick="CloseImageModal"></button>
                    <img src="@currentImageUrl" class="img-fluid rounded shadow-lg" style="max-height: 85vh;" @onclick:stopPropagation />
                </div>
            </div>
        </div>
    </div>
}
<style>
    .page-container {
        padding: 25px;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
    }

    .header-actions {
        display: flex;
        gap: 10px;
    }

    .cattle-title {
        color: var(--accent-orange);
        font-size: 28px;
        font-weight: bold;
        margin: 0;
    }

    .detail-label {
        color: var(--text-secondary);
        font-size: 12px;
        text-transform: uppercase;
        font-weight: 600;
        margin-bottom: 5px;
        display: block;
    }

    .image-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(80px, 1fr));
        gap: 10px;
    }

    .image-thumbnail {
        position: relative;
        aspect-ratio: 1; /* Makes it a square */
        overflow: hidden;
        border-radius: 6px;
        cursor: pointer;
        border: 1px solid var(--border-color);
    }

    .image-thumbnail img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.2s;
    }

    .image-thumbnail:hover img {
        transform: scale(1.1);
    }

    /* Hover overlay effect */
    .image-thumbnail .overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.4);
        display: flex;
        justify-content: center;
        align-items: center;
        opacity: 0;
        transition: opacity 0.2s;
    }

    .image-thumbnail:hover .overlay {
        opacity: 1;
    }

    .image-thumbnail .overlay i {
        color: white;
        font-size: 1.2rem;
    }

    .detail-value {
        color: var(--text-primary);
        font-size: 16px;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .detail-value i {
        color: var(--accent-orange);
        font-size: 18px;
    }

    .images-placeholder {
        text-align: center;
        padding: 30px 20px;
        background-color: var(--primary-bg);
        border-radius: 8px;
    }

    .placeholder-icon {
        font-size: 48px;
        color: var(--text-secondary);
    }

    .modal {
        background: var(--modal-backdrop);
    }

    .modal-backdrop {
        background-color: var(--modal-backdrop);
    }

    /* Modal content and alert styles */
    .modal-content {
        background-color: var(--card-bg) !important;
        color: var(--text-primary) !important;
    }

    .modal-header,
    .modal-footer {
        border-color: var(--border-color) !important;
    }

    .modal-title {
        color: var(--text-primary) !important;
    }

    .alert {
        border-radius: var(--border-radius-sm) !important;
    }

    .alert-danger {
        background-color: #DC3545 !important;
        color: white !important;
        border: none !important;
    }

    .alert-success {
        background-color: var(--primary-green) !important;
        color: white !important;
        border: none !important;
    }

    .text-secondary {
        color: var(--text-secondary) !important;
    }

    /* Card styles override */
    .card {
        background-color: var(--card-bg) !important;
        color: var(--text-primary) !important;
    }

    .card-header h5 {
        color: var(--text-primary) !important;
    }

    /* ── Form helpers compartidos con Cattle.razor ───────────── */
    .form-divider {
        border: 0;
        border-top: 1.5px dashed var(--border-color);
        margin: 18px 0 16px;
    }

    .form-section-title {
        color: var(--text-secondary);
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        margin-bottom: 12px;
    }

    .cert-checkboxes {
        display: flex;
        flex-wrap: wrap;
        gap: 8px 14px;
    }

    .cert-checkbox {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 12px;
        border: 1.5px solid var(--border-color);
        border-radius: var(--border-radius-sm);
        background: var(--card-bg);
        cursor: pointer;
        transition: all 0.15s;
    }

    .cert-checkbox:has(input:checked) {
        border-color: var(--primary-green);
        background: var(--green-light);
    }

    .cert-checkbox-label {
        font-size: 13px;
        font-weight: 600;
        color: var(--text-primary);
    }

    /* ── Layout estilo "carta del animal" ────────────────────── */
    .cattle-card-layout {
        display: grid;
        grid-template-columns: 1.05fr 1.4fr 1.4fr;
        gap: 18px;
        margin-top: 8px;
    }

    .ca-card {
        background: var(--card-bg);
        border: 1.5px solid var(--border-color);
        border-radius: var(--border-radius);
        padding: 18px 18px 16px;
        box-shadow: var(--shadow);
