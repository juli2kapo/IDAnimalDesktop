    }

    .ca-icon-orange { background: var(--warning); }
    .ca-icon-red    { background: #C84A2A; }
    .ca-icon-green  { background: var(--primary-green); }

    /* Top row cards: 10% más compactas en altura */
    .ca-photo,
    .ca-sanitary,
    .ca-feed {
        padding-top: 14px;
        padding-bottom: 12px;
    }

        .ca-photo .ca-card-header,
        .ca-sanitary .ca-card-header,
        .ca-feed .ca-card-header {
            margin-bottom: 10px;
        }

    /* Foto principal (col-1, row-1) */
    .ca-photo {
        grid-column: 1;
