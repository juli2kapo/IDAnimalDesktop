@page "/"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using IdAnimal.Web.Services
@inject AuthStateProvider AuthStateProvider
@inject NavigationManager Navigation

<PageTitle>IdAnimal - Sistema de Gestión de Ganado</PageTitle>

@if (!isReady)
{
    @* Estado neutro mientras se resuelve la sesión (el token recién está
       disponible cuando conecta el circuito interactivo, por el
       prerender: false). Evita el destello de la landing de productor
       antes de redirigir a un usuario cliente. *@
}
else if (!isClientUser)
{
<div class="landing-page">
    <div class="hero-section">
        <div class="hero-content">
            <span class="hero-eyebrow">Gestión Ganadera</span>
            <h1>IdAnimal</h1>
            <p class="tagline">Identificación biométrica y trazabilidad del rodeo</p>
            <p class="description">
                Gestioná establecimientos, registrá tu ganado y mantené el control
                total de la producción. Identificación por morro, pesaje y reportes
                listos para imprimir.
            </p>
            <div class="cta-buttons">
                <a href="/cattle" class="btn btn-light-on-green">Ver Ganado</a>
                <a href="/establishments" class="btn btn-ghost-on-green">Establecimientos</a>
            </div>
        </div>
        <div class="hero-image">
            <div class="hero-badge">
                <i class="bi bi-clipboard-data"></i>
                <span class="hero-badge-label">CAMPO</span>
            </div>
        </div>
    </div>

    <div class="features-section">
        <div class="features-header">
            <span class="section-eyebrow">Plataforma</span>
            <h2>Características Principales</h2>
        </div>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="feature-card">
                    <i class="bi bi-building feature-icon"></i>
                    <h3>Establecimientos</h3>
                    <p>Gestioná múltiples campos con información detallada y estadísticas en tiempo real.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feature-card">
                    <i class="bi bi-list-ul feature-icon"></i>
                    <h3>Registro de Ganado</h3>
                    <p>Caravana, peso, origen, género, GDM y datos personalizados — todo en un solo lugar.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feature-card">
                    <i class="bi bi-camera feature-icon"></i>
                    <h3>Identificación Biométrica</h3>
                    <p>Identificá ganado por fotografía del morro con tecnología de reconocimiento avanzada.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feature-card">
                    <i class="bi bi-cloud-upload feature-icon"></i>
                    <h3>Almacenamiento en la Nube</h3>
                    <p>Imágenes y videos guardados de forma segura, accesibles desde cualquier dispositivo.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feature-card">
                    <i class="bi bi-file-earmark-spreadsheet feature-icon"></i>
                    <h3>Importación Excel/CSV</h3>
                    <p>Cargá datos masivos desde planillas de cálculo en pocos clics.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feature-card">
                    <i class="bi bi-file-pdf feature-icon"></i>
                    <h3>Reportes PDF</h3>
                    <p>Generá reportes profesionales para presentar a clientes o autoridades.</p>
                </div>
            </div>
        </div>
    </div>
</div>
}

<style>
    .landing-page {
        min-height: 100vh;
    }

    /* Hero — verde campo, igual sentimiento que el card "Nueva sesión" del teléfono */
    .hero-section {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 70px 60px;
        background: linear-gradient(135deg, var(--primary-green) 0%, var(--green-dark) 100%);
        color: white;
        gap: 40px;
        overflow: hidden;
        border-bottom: 4px solid var(--green-dark);
    }

    .hero-section::before {
        content: "";
        position: absolute;
        top: -120px;
        right: -120px;
        width: 360px;
        height: 360px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.06);
        pointer-events: none;
    }

    .hero-section::after {
        content: "";
        position: absolute;
        bottom: -200px;
        left: -120px;
        width: 420px;
        height: 420px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.04);
        pointer-events: none;
    }

    .hero-content {
        flex: 1;
        max-width: 620px;
        position: relative;
        z-index: 1;
    }

    .hero-eyebrow {
        display: inline-block;
        background: rgba(255, 255, 255, 0.18);
        color: white;
        padding: 5px 14px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 2px;
        text-transform: uppercase;
        margin-bottom: 18px;
    }

    .hero-content h1 {
        font-size: 4.2rem;
        font-weight: 900;
        margin-bottom: 16px;
        color: white;
        letter-spacing: 3px;
        text-transform: uppercase;
        line-height: 1;
    }

    .tagline {
        font-size: 1.4rem;
        margin-bottom: 14px;
        opacity: 0.95;
        font-weight: 600;
        letter-spacing: 0.5px;
    }

    .description {
        font-size: 1.05rem;
        margin-bottom: 28px;
        opacity: 0.9;
        line-height: 1.6;
        max-width: 540px;
    }

    .cta-buttons {
        display: flex;
        gap: 14px;
        flex-wrap: wrap;
    }

    .btn-light-on-green {
        background: white !important;
        color: var(--green-dark) !important;
        border: 2px solid white !important;
        font-weight: 800 !important;
        letter-spacing: 1px;
        text-transform: uppercase;
        padding: 12px 24px;
        border-radius: var(--border-radius-sm);
        transition: transform 0.15s, box-shadow 0.15s;
    }

    .btn-light-on-green:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 18px rgba(0, 0, 0, 0.25);
        color: var(--green-dark) !important;
        text-decoration: none;
    }

    .btn-ghost-on-green {
        background: transparent !important;
        color: white !important;
        border: 2px solid rgba(255, 255, 255, 0.7) !important;
        font-weight: 800 !important;
        letter-spacing: 1px;
        text-transform: uppercase;
        padding: 12px 24px;
        border-radius: var(--border-radius-sm);
        transition: all 0.15s;
    }

    .btn-ghost-on-green:hover {
        background: rgba(255, 255, 255, 0.15) !important;
        border-color: white !important;
        color: white !important;
        text-decoration: none;
    }

    .hero-image {
        flex: 0 0 auto;
        text-align: center;
        position: relative;
        z-index: 1;
    }

    .hero-badge {
        display: inline-flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        width: 200px;
        height: 200px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.10);
        border: 3px solid rgba(255, 255, 255, 0.35);
        backdrop-filter: blur(2px);
    }

    .hero-badge i {
        font-size: 76px;
        color: white;
        margin-bottom: 8px;
    }

    .hero-badge-label {
        color: white;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 3px;
        text-transform: uppercase;
    }

    /* Features */
    .features-section {
        padding: 70px 60px;
        background: var(--primary-bg);
    }

    .features-header {
        text-align: center;
        margin-bottom: 50px;
    }

    .section-eyebrow {
        display: inline-block;
        color: var(--primary-green);
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 3px;
        text-transform: uppercase;
        margin-bottom: 8px;
        padding: 4px 14px;
        border: 1.5px solid var(--primary-green);
        border-radius: 20px;
        background: var(--green-light);
    }

    .features-section h2 {
        text-align: center;
        font-size: 2.2rem;
        margin: 0;
        color: var(--text-primary);
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 1.5px;
    }

    .feature-card {
        background: var(--card-bg);
        padding: 32px 24px;
        border-radius: var(--border-radius);
        border: 1.5px solid var(--border-color);
        box-shadow: var(--shadow);
        text-align: center;
        height: 100%;
        transition: transform 0.25s, box-shadow 0.25s, border-color 0.25s;
    }

    .feature-card:hover {
        transform: translateY(-4px);
        box-shadow: var(--shadow-lg);
        border-color: var(--primary-green);
    }

    .feature-icon {
        font-size: 38px !important;
        color: var(--primary-green) !important;
        margin-bottom: 18px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 78px;
        height: 78px;
        border-radius: 50%;
        background: var(--green-light);
        border: 2px solid var(--primary-green);
    }

    .feature-card h3 {
        font-size: 1.1rem;
        margin-bottom: 10px;
        color: var(--text-primary);
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.6px;
    }

    .feature-card p {
        color: var(--text-secondary);
        line-height: 1.55;
        font-size: 0.95rem;
        margin: 0;
    }

    @@media (max-width: 992px) {
        .hero-section {
            padding: 50px 30px;
        }

        .hero-content h1 {
            font-size: 3rem;
        }

        .hero-badge {
            width: 160px;
            height: 160px;
        }

        .hero-badge i {
            font-size: 60px;
        }
    }

    @@media (max-width: 768px) {
        .hero-section {
            flex-direction: column;
            padding: 40px 20px;
            text-align: center;
        }

        .hero-content h1 {
            font-size: 2.4rem;
        }

        .hero-image {
            display: none;
        }

        .cta-buttons {
            flex-direction: column;
            justify-content: center;
        }

        .features-section {
            padding: 40px 20px;
        }

        .features-section h2 {
            font-size: 1.7rem;
        }
    }
</style>

@code {
    private bool isReady = false;
    private bool isClientUser = false;
    private bool yaRedirigido = false;

    protected override async Task OnInitializedAsync()
    {
        // OJO: en una página prerenderizada esto corre DOS veces — una del lado
        // del servidor y otra cuando conecta el circuito interactivo. Sin la
        // guarda, el NavigateTo se dispara dos veces y la página "se refresca
        // sola" a ojos del usuario, que es justo lo que reportó.
        if (yaRedirigido) return;

        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        var tipo = state.User.Identity?.IsAuthenticated == true
            ? state.User.FindFirst("typ")?.Value
            : null;

        if (tipo == "client")
        {
            // Usuario de aseguradora: su home es el dashboard de cliente, no la
            // landing de productor. Redirect en vez de duplicar el markup.
            yaRedirigido = true;
            Navigation.NavigateTo("/cliente", replace: true);
            return;
        }

        // No autenticado, o productor (incluye tokens viejos sin claim `typ`):
        // la landing de productor de siempre.
        isReady = true;
    }
}
