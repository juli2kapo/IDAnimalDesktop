@page "/register"
@layout IdAnimal.Web.Components.Layout.EmptyLayout
@using IdAnimal.Shared.DTOs
@using IdAnimal.Web.Services
@inject AuthService AuthService
@inject AuthStateProvider AuthStateProvider
@inject NavigationManager Navigation
@rendermode InteractiveServer
<PageTitle>Registro - IdAnimal</PageTitle>

<div class="login-container">
    <div class="login-card">
        <div class="login-header">
            <span class="login-eyebrow">Nuevo Usuario</span>
            <h1>Crear Cuenta</h1>
            <p>Sistema de Gestión de Ganado</p>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger">
                @errorMessage
            </div>
        }

        <EditForm Model="@registerRequest" OnValidSubmit="@HandleRegister" FormName="RegisterForm">
            <DataAnnotationsValidator />

            <div class="form-group">
                <label for="fullName">Nombre Completo</label>
                <InputText id="fullName" class="form-control" @bind-Value="registerRequest.FullName" placeholder="Juan Pérez" />
                <ValidationMessage For="@(() => registerRequest.FullName)" />
            </div>

            <div class="form-group">
                <label for="email">Email</label>
                <InputText id="email" class="form-control" @bind-Value="registerRequest.Email" placeholder="tu@email.com" />
                <ValidationMessage For="@(() => registerRequest.Email)" />
            </div>

            <div class="form-group">
                <label for="password">Contraseña</label>
                <InputText id="password" type="password" class="form-control" @bind-Value="registerRequest.Password" placeholder="••••••••" />
                <ValidationMessage For="@(() => registerRequest.Password)" />
            </div>

            <button type="submit" class="btn btn-primary btn-block" disabled="@isLoading">
                @if (isLoading)
                {
                    <span class="spinner-border spinner-border-sm" role="status"></span>
                    <span> Registrando...</span>
                }
                else
                {
                    <span>Registrarse</span>
                }
            </button>
        </EditForm>

        <div class="register-link">
            <p>¿Ya tienes cuenta? <a href="/login">Inicia sesión aquí</a></p>
        </div>
    </div>
</div>

<style>
    .login-container {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
        background:
            radial-gradient(circle at 20% 20%, rgba(74, 103, 65, 0.18), transparent 55%),
            radial-gradient(circle at 80% 80%, rgba(46, 74, 40, 0.20), transparent 55%),
            linear-gradient(135deg, var(--primary-green) 0%, var(--green-dark) 100%);
        padding: 20px;
    }

    .login-card {
        background: var(--card-bg);
        border: 2px solid var(--border-strong);
        border-radius: var(--border-radius);
        box-shadow: 0 18px 48px rgba(0, 0, 0, 0.32);
        padding: 40px 38px;
        width: 100%;
        max-width: 460px;
    }

    .login-header {
        text-align: center;
        margin-bottom: 28px;
    }

    .login-eyebrow {
        display: inline-block;
        color: var(--primary-green);
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 3px;
        text-transform: uppercase;
        padding: 4px 14px;
        border: 1.5px solid var(--primary-green);
        border-radius: 20px;
        background: var(--green-light);
        margin-bottom: 14px;
    }

    .login-header h1 {
        color: var(--text-primary);
        font-size: 2rem;
        margin-bottom: 6px;
        font-weight: 900;
        letter-spacing: 1.5px;
        text-transform: uppercase;
    }

    .login-header p {
        color: var(--text-secondary);
        font-size: 0.95rem;
        font-weight: 600;
        margin: 0;
        letter-spacing: 0.4px;
    }

    .form-group {
        margin-bottom: 18px;
    }

    .form-group label {
        display: block;
        color: var(--text-secondary);
        font-size: 12px;
        font-weight: 700;
        margin-bottom: 6px;
        letter-spacing: 0.6px;
        text-transform: uppercase;
    }

    .btn-block {
        width: 100%;
        padding: 14px 20px !important;
        font-size: 14px !important;
        margin-top: 6px;
    }

    .register-link {
        text-align: center;
        margin-top: 22px;
        padding-top: 18px;
        border-top: 1.5px dashed var(--border-color);
    }

    .register-link p {
        color: var(--text-secondary);
        font-size: 0.9rem;
        margin: 0;
    }
</style>

@code {
    private RegisterRequest registerRequest = new();
    private string? errorMessage;
    private bool isLoading = false;

    private async Task HandleRegister()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var response = await AuthService.RegisterAsync(registerRequest);

            if (response != null)
            {
                await AuthStateProvider.LoginAsync(response.Token); 
                Navigation.NavigateTo("/");
            }
            else
            {
                errorMessage = "El email ya está registrado o los datos son inválidos";
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Error al conectar con el servidor. Por favor, intente nuevamente.";
        }
        finally
        {
            isLoading = false;
        }
    }
}
