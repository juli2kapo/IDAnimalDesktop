@using Microsoft.AspNetCore.Components.Authorization
<CascadingAuthenticationState>
<Router AppAssembly="typeof(Program).Assembly">
    <Found Context="routeData">
        @if (EsRutaPublica(routeData))
        {
            @* La ficha pública (/a/{id}) no pasa por autorización.
               AuthorizeRouteView monta su DefaultLayout (MainLayout) mientras
               resuelve la sesión y recién después aplica el @layout de la página:
               eso hacía que se viera un destello del panel (la barra verde
               superior) antes de la ficha. Con RouteView no hay espera ni
               layout intermedio. *@
            <RouteView RouteData="routeData" DefaultLayout="typeof(Layout.EmptyLayout)" />
        }
        else
        {
            <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
                <NotAuthorized>
                    @* This shows if a user tries to access a protected page while logged out *@
                    <div class="alert alert-warning m-4">
                        <h3>Acceso Denegado</h3>
                        <p>Debes iniciar sesión para ver esta página.</p>
                        <a href="login" class="btn btn-primary">Ir al Login</a>
                    </div>
                </NotAuthorized>
                @* Vacío a propósito: si no, Blazor muestra su "Authorizing..." por
                   defecto mientras lee el JWT de ProtectedLocalStorage. Va un
                   <text></text> y no sólo un comentario porque un fragmento con
                   únicamente comentarios compila a null y vuelve al default. *@
                <Authorizing><text></text></Authorizing>
            </AuthorizeRouteView>
        }
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound>
        <PageTitle>No encontrada</PageTitle>
        <LayoutView Layout="typeof(Layout.MainLayout)">
             <div class="text-center" style="padding: 40px;">
                <h1>404 - Página no encontrada</h1>
                <a href="/" class="btn btn-primary">Ir al inicio</a>
            </div>
        </LayoutView>
    </NotFound>
</Router>
</CascadingAuthenticationState>

@code {
    /// <summary>
    /// Páginas que se sirven sin autorización. Se comparan por tipo y no por URL
    /// para que no se desincronice si cambia la ruta de la página.
    /// </summary>
    private static readonly HashSet<Type> RutasPublicas = new()
    {
        typeof(Pages.PublicAnimal),
        typeof(Pages.Cliente.Registro),
    };

    private static bool EsRutaPublica(RouteData routeData)
        => RutasPublicas.Contains(routeData.PageType);
}